#!/usr/bin/env bash
set -euo pipefail
here=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")

# Keep global presentation options out of subcommand argument parsers.
args=()
for arg in "$@"; do
    if [ "$arg" = --verbose ]; then
        export DLLMGR_VERBOSE=1
    else
        args+=("$arg")
    fi
done
set -- "${args[@]}"

usage() {
    cat <<'USAGE'
Usage:
  dllmgr [--verbose] fix [--exe PATH] [--yes] [--dry-run]
  dllmgr fix faststone [--exe PATH/FSViewer.exe] [--build]
  dllmgr fix faststone-avif [--prefix PATH]
  dllmgr fix faststone-fonts [--prefix PATH]
  dllmgr run faststone [--exe PATH] [--prefix PATH] -- [FILES...]
  dllmgr status faststone [--prefix PATH]
  dllmgr fix|unfix|status photoshop-cs2 [--exe PATH/Photoshop.exe] [--prefix PATH]
  dllmgr run photoshop-cs2 [--exe PATH] [--prefix PATH] -- [FILES...]
  dllmgr set photoshop-cs2|faststone [text=system|bitmap|gray|light|cleartype] [contrast=1.0..4.0] [scaling=exact|smooth]
  dllmgr unfix faststone
  dllmgr unfix faststone-avif [--prefix PATH]
  dllmgr unfix faststone-fonts [--prefix PATH]
  dllmgr cleanup [FIX] [--dry-run] [--yes]   remove all traces of dllmgr (or of one fix)
  dllmgr share faststone
  dllmgr diag [--prefix PATH]      read-only debug report to paste into an issue
Wine commands use WINEPREFIX (default: ~/.wine).
'dllmgr fix' alone finds the programs with verified recipes and asks before
applying each one. Set DLLMGR_VERBOSE=1 or pass --verbose for detailed output.
USAGE
}

case ${1:-} in
    fix)
        if [ "${2:-}" = faststone-fonts ]; then
            shift 2
            exec "$here/scripts/apply-winehq-26037.sh" "$@"
        fi
        if [ "${2:-}" = faststone-avif ]; then
            shift 2
            exec "$here/scripts/apply-winehq-60703.sh" "$@"
        fi
        if [ "${2:-}" = faststone ]; then
            shift 2
            export DLLMGR_REQUIRE_PROFILE=1
            exec "$here/scripts/apply-faststone.sh" "$@"
        fi
        if [ "${2:-}" = photoshop-cs2 ]; then
            shift 2
            exec python3 "$here/scripts/private-app.py" install --app photoshop-cs2 "$@"
        fi
        shift
        exec "$here/scripts/fix-prefix.sh" "$@"
        ;;
    unfix|uninstall)  # "uninstall" kept for old scripts
        if [ "${2:-}" = faststone-fonts ]; then
            shift 2
            exec "$here/scripts/undo-winehq-26037.sh" "$@"
        fi
        if [ "${2:-}" = faststone-avif ]; then
            shift 2
            exec "$here/scripts/undo-winehq-60703.sh" "$@"
        fi
        if [ "${2:-}" = photoshop-cs2 ]; then
            shift 2
            exec python3 "$here/scripts/private-app.py" uninstall --app photoshop-cs2 "$@"
        fi
        [ "${2:-}" = faststone ] || { usage >&2; exit 2; }
        shift 2
        export DLLMGR_REQUIRE_PROFILE=1
        exec "$here/scripts/undo-faststone.sh" "$@"
        ;;
    run|status|set)
        command=$1
        case ${2:-} in
            faststone|photoshop-cs2) app=$2 ;;
            *) usage >&2; exit 2 ;;
        esac
        shift 2
        exec python3 "$here/scripts/private-app.py" "$command" --app "$app" "$@"
        ;;
    cleanup)
        shift
        exec python3 "$here/scripts/cleanup.py" "$@"
        ;;
    share)
        shift
        exec python3 "$here/scripts/share-recipe.py" "$@"
        ;;
    diag)
        shift
        exec python3 "$here/scripts/diag.py" "$@"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
