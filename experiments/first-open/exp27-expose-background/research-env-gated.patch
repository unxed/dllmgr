diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 4bceb90..ddd7a86 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2380,6 +2380,8 @@ static BOOL expose_window_surface( HWND hwnd, UINT flags, const RECT *rect, UINT
         return TRUE;
     }
 
+    /* EXPERIMENT #27: do not mark exposed areas dirty at all */
+    if (getenv( "DLLMGR_EXP27" )) { window_surface_release( surface ); return TRUE; }
     window_surface_lock( surface );
     if (!rect) add_bounds_rect( &surface->bounds, &surface->rect );
     else
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 7ff9b88..bf3ad39 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -533,6 +533,13 @@ static int get_window_attributes( struct x11drv_win_data *data, XSetWindowAttrib
     if (!(ex_style & WS_EX_TRANSPARENT)) attr->event_mask |= (PointerMotionMask | ButtonPressMask |
                                                               ButtonReleaseMask | EnterWindowMask);
 
+    /* EXPERIMENT #27B: no X background, keep what was on screen until painted */
+    if (getenv( "DLLMGR_EXP27B" ))
+    {
+        attr->background_pixmap = None;
+        return (CWSaveUnder | CWColormap | CWBorderPixel | CWBackPixmap |
+                CWEventMask | CWBitGravity | CWBackingStore);
+    }
     return (CWSaveUnder | CWColormap | CWBorderPixel | CWBackPixel |
             CWEventMask | CWBitGravity | CWBackingStore);
 }
