+        data->whole_window != root_window && data->current_state.wm_state == NormalState)
+    {
+        pthread_mutex_lock( &held_mutex );
+        held.hwnd = data->hwnd;
+        held.display = data->display;
+        held.window = data->whole_window;
+        held.screen = data->vis.screen;
+        held.mask = mask;
+        held.changes = changes;
+        held.tick = NtGetTickCount();
+        pthread_mutex_unlock( &held_mutex );
+        TRACE( "holding the resize of %p until its next flush\n", data->hwnd );
+        return;
+    }
     XReconfigureWMWindow( data->display, data->whole_window, data->vis.screen, mask, &changes );
