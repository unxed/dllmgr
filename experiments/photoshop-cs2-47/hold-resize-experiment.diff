+/* dllmgr #47: an application's resize of its window (Photoshop grows the
+ * document window when zooming) became visible at once, while the window's
+ * new contents came one surface flush later: the newly exposed strips showed
+ * stale screen pixels for a frame or more. With DLLMGR47_HOLD=1 a size change
+ * requested by the application is held back until the next flush of that
+ * window's surface (or 100 ms), so the new size and the new paint appear
+ * together. One window at a time; any other configure releases it first. */
+static pthread_mutex_t held_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct
+{
+    HWND hwnd;
+    Display *display;
+    Window window;
+    int screen;
+    unsigned int mask;
+    XWindowChanges changes;
+    UINT tick;
+} held;
+
+static BOOL dllmgr47_hold_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0)
+    {
+        const char *env = getenv( "DLLMGR47_HOLD" );
+        enabled = env && *env == '1';
+    }
+    return enabled;
+}
+
+/* hwnd: release that window's held resize; NULL: any held resize, or only an
+ * old one (> 100 ms) when timeout_only */
+void dllmgr47_release_held( HWND hwnd, BOOL timeout_only )
+{
+    if (!held.hwnd) return;
+    pthread_mutex_lock( &held_mutex );
+    if (held.hwnd && (hwnd ? held.hwnd == hwnd : !timeout_only || NtGetTickCount() - held.tick > 100))
+    {
+        TRACE( "releasing held resize of %p\n", held.hwnd );
+        XReconfigureWMWindow( held.display, held.window, held.screen, held.mask, &held.changes );
+        XFlush( held.display );
+        held.hwnd = 0;
+    }
+    pthread_mutex_unlock( &held_mutex );
+}
+
 static void window_set_config( struct x11drv_win_data *data, RECT rect, BOOL above )
 {
     UINT style = NtUserGetWindowLongW( data->hwnd, GWL_STYLE ), mask = 0;
@@ -1486,6 +1532,22 @@
     data->configure_serial = NextRequest( data->display );
     TRACE( "window %p/%lx, requesting config %s mask %#x above %u, serial %lu\n", data->hwnd, data->whole_window,
            wine_dbgstr_rect(new_rect), mask, above, data->configure_serial );
+    dllmgr47_release_held( NULL, FALSE );  /* keep the order of configure requests */
