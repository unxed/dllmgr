+            err = dev->funcs->pPutImage( dev, NULL, dst_info, &src_bits, &src, &dst, SRCCOPY );
+        if (err == ERROR_TRANSFORM_NOT_SUPPORTED)
+        {
+            copy_bitmapinfo( src_info, dst_info );
+            err = stretch_bits( src_info, &src, dst_info, &dst, &src_bits, COLORONCOLOR );
+            if (!err) err = dev->funcs->pPutImage( dev, NULL, dst_info, &src_bits, &src, &dst, SRCCOPY );
+        }
+        if (err) lines = 0;
