+/* dllmgr #52: "GDI scaling" (DLLMGR52_GDI_SCALE=1): window DCs of a window
+ * scaled by an integer factor draw straight into the target surface with a
+ * hidden scale under the application's mapping, so text is rasterised at the
+ * physical resolution. Layered windows keep the 96-DPI path. */
+static UINT gdi_scale_factor( struct window_surface *window_surface )
+{
+    static int enabled = -1;
+    struct scaled_surface *surface;
+    if (enabled == -1) enabled = getenv( "DLLMGR52_GDI_SCALE" ) != NULL;
+    if (!enabled || !window_surface || window_surface->alpha_mask || window_surface->color_key != CLR_INVALID)
+        return 1;
+    surface = CONTAINING_RECORD( window_surface, struct scaled_surface, header );
+    if (surface->dpi_to <= surface->dpi_from || surface->dpi_to % surface->dpi_from) return 1;
+    return surface->dpi_to / surface->dpi_from;
+}
+
