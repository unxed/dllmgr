+/* dllmgr #52: the 96-DPI bits of a GDI-scaled window are never written, so
+ * kept bits come from its target surface at k x the size. The rows are
+ * copied out first, so the target is not locked while hdc draws. */
+static BOOL move_gdi_scaled_bits( HDC hdc, struct scaled_surface *scaled, const RECT *src, const RECT *dst )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    struct window_surface *target = scaled->target_surface;
+    UINT k = scaled->dpi_to / scaled->dpi_from;
+    int x = (src->left - scaled->header.rect.left) * k, y = (src->top - scaled->header.rect.top) * k;
+    int w = (src->right - src->left) * k, h = (src->bottom - src->top) * k, stride, rows, i, row;
+    char *copy, *bits;
+
+    if (k < 2 || w <= 0 || h <= 0) return FALSE;
+    window_surface_lock( target );
+    bits = window_surface_get_color( target, info );
+    rows = abs( info->bmiHeader.biHeight );
+    stride = ((info->bmiHeader.biWidth * info->bmiHeader.biBitCount + 31) / 32) * 4;
+    if (!bits || y < 0 || y + h > rows || x < 0 || x + w > info->bmiHeader.biWidth ||
+        !(copy = malloc( (size_t)stride * h )))
+    {
+        window_surface_unlock( target );
+        return FALSE;
+    }
+    for (i = 0; i < h; i++)
+    {
+        row = info->bmiHeader.biHeight < 0 ? y + i : rows - 1 - (y + i);
+        memcpy( copy + (size_t)i * stride, bits + (size_t)row * stride, stride );
+    }
+    window_surface_unlock( target );
+    info->bmiHeader.biHeight = -h;
+    info->bmiHeader.biSizeImage = 0;
+    /* hdc carries the hidden scale k: the destination grows by k, so this is 1:1 */
+    NtGdiStretchDIBitsInternal( hdc, dst->left, dst->top, dst->right - dst->left, dst->bottom - dst->top,
+                                x, 0, w, h, copy, info, DIB_RGB_COLORS, SRCCOPY, 0, 0, NULL );
+    free( copy );
+    return TRUE;
+}
