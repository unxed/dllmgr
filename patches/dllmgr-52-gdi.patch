+static inline int floor_div( int value, int k )
+{
+    return value >= 0 ? value / k : -((-value + k - 1) / k);
+}
+
+/* The region variant of a diagonal line ends one pixel late (solid_line_region
+ * adds a pixel after the last step), unlike the direct one: cut the end pixel,
+ * so the scaled line equals the unscaled drawing. */
+static BOOL scaled_thin_segment( dibdrv_physdev *pdev, BOOL (*line)(dibdrv_physdev *, POINT *, POINT *, HRGN),
+                                 POINT *start, POINT *end, HRGN lines )
+{
+    HRGN segment, last;
+    BOOL ret;
+
+    if (start->x == end->x || start->y == end->y) return line( pdev, start, end, lines );
+    if (!(segment = NtGdiCreateRectRgn( 0, 0, 0, 0 ))) return FALSE;
+    if ((ret = line( pdev, start, end, segment )) &&
+        (last = NtGdiCreateRectRgn( end->x, end->y, end->x + 1, end->y + 1 )))
+    {
+        NtGdiCombineRgn( segment, segment, last, RGN_DIFF );
+        NtGdiDeleteObjectApp( last );
+    }
+    NtGdiCombineRgn( lines, lines, segment, RGN_OR );
+    NtGdiDeleteObjectApp( segment );
+    return ret;
+}
+
+/* dllmgr #52: a 1-pixel pen on a GDI-scaled DC draws the 96-DPI line and
+ * paints each of its pixels as a k x k block: exactly the upscale of the
+ * unscaled drawing, so a line drawn over blitted content covers the whole
+ * block row (no residue) and XOR shapes still cancel out. Device points are
+ * k times the 96-DPI ones (the right/bottom corners of shapes are one less),
+ * so the 96-DPI pixel is the floor of the quotient. */
+static BOOL scaled_thin_pen_lines(dibdrv_physdev *pdev, int num, POINT *pts, BOOL close, HRGN region)
+{
+    DC *dc = get_physdev_dc( &pdev->dev );
+    BOOL (*line)(dibdrv_physdev *, POINT *, POINT *, HRGN) = pdev->dllmgr_thin_dashed ? dashed_pen_line_region : solid_pen_line_region;
+    int k = dc->dllmgr_scale, i, n = 0;
+    BOOL ret = TRUE;
+    POINT *small, p;
+    HRGN lines, big;
+
+    assert( num >= 2 && region );
+    if (!(small = malloc( num * sizeof(*small) ))) return FALSE;
+    for (i = 0; i < num; i++)
+    {
+        p.x = floor_div( pts[i].x, k );
+        p.y = floor_div( pts[i].y, k );
+        if (n && p.x == small[n - 1].x && p.y == small[n - 1].y) continue;
+        /* curves (ellipse, round corners) come as device points one pixel
+         * apart: drop the corner of an L step, so the 96-DPI curve stays
+         * one pixel thin (8-connected) like the unscaled one */
+        if (n >= 2 && abs( p.x - small[n - 2].x ) == 1 && abs( p.y - small[n - 2].y ) == 1 &&
+            abs( small[n - 1].x - small[n - 2].x ) + abs( small[n - 1].y - small[n - 2].y ) == 1)
+            n--;
+        small[n++] = p;
+    }
+    if (n < 2) small[n++] = small[0];  /* a dot: draw its start pixel */
+    num = n;
+    if (!(lines = NtGdiCreateRectRgn( 0, 0, 0, 0 )))
+    {
+        free( small );
+        return FALSE;
+    }
+    for (i = 0; ret && i < num - 1; i++) ret = scaled_thin_segment( pdev, line, small + i, small + i + 1, lines );
+    if (ret && close) ret = scaled_thin_segment( pdev, line, small + num - 1, small, lines );
+    if (ret && (big = map_dpi_region( lines, 1, k )))
+    {
+        NtGdiCombineRgn( region, region, big, RGN_OR );
+        NtGdiDeleteObjectApp( big );
+    }
+    else ret = FALSE;
+    NtGdiDeleteObjectApp( lines );
+    free( small );
+    return ret;
+}
