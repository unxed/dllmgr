@@ -1334,6 +1334,46 @@ static void update_lock_state( HWND hwnd, WORD vkey, UINT state, UINT time )
  *
  * Handle a X key event
  */
+/* dllmgr #49: Windows keeps one keyboard layout per input language and
+ * ToUnicodeEx answers for the layout it is given. Wine reports the locale's
+ * layout whatever the active XKB group is and answers ToUnicodeEx from the
+ * group of the last key event. Photoshop CS2 (and others) map their shortcut
+ * letters with ToUnicodeEx(..., US layout), so with a Cyrillic group active
+ * no shortcut letter is found. Here: the active group's script decides the
+ * reported layout (Cyrillic group -> Russian layout, else the locale's), and
+ * an explicit US layout for a Cyrillic group is answered from the US table.
+ * Text input (TranslateMessage uses the reported layout) keeps the group's
+ * characters. DLLMGR49_NO_LAYOUT_TRACKING=1 turns it off. */
+static int dllmgr49_disabled(void)
+{
+    static int disabled = -1;
+    if (disabled == -1) disabled = getenv( "DLLMGR49_NO_LAYOUT_TRACKING" ) != NULL;
+    return disabled;
+}
+
+static BOOL dllmgr49_group_is_cyrillic( Display *display, unsigned int state )
+{
+    KeyCode a_key = XKeysymToKeycode( display, XK_a );
+    KeySym sym;
+    if (!a_key) return FALSE;
+    sym = XkbKeycodeToKeysym( display, a_key, (state >> 13) & 3, 0 );
+    return (sym >> 8) == 0x06;
+}
+
+static void dllmgr49_track_layout( Display *display, unsigned int state )
+{
+    static HKL base;
+    HKL current, want;
+
+    if (dllmgr49_disabled()) return;
+    current = NtUserGetKeyboardLayout( 0 );
+    if (!base) base = current;
+    want = dllmgr49_group_is_cyrillic( display, state ) ? (HKL)(ULONG_PTR)0x04190419 : base;
+    if (want == current) return;
+    TRACE_(key)( "XKB group %u: keyboard layout %p -> %p\n", (state >> 13) & 3, current, want );
+    NtUserActivateKeyboardLayout( want, 0x40000000 );
+}
