+/* dllmgr #80: a DPI-unaware thread that draws on a desktop window DC
+ * (GetDC(0), GetWindowDC(GetDesktopWindow()), GetDCEx(desktop, ...)) uses the
+ * logical coordinates it gets from GetCursorPos/GetWindowRect. Windows draws
+ * them 1:1 on the physical screen (tests/wine/screendc80.c, 175 %), so XOR
+ * drag outlines (Photoshop CS2 palettes, MFC/Delphi drag rects) land at half
+ * the position at 200 %. Scale such DCs from the thread's virtual screen to
+ * the physical one, as Windows does for the windows of such a thread.
+ * Every call sets or clears it, since cache DCs are shared. DLLMGR80_OFF=1:
+ * Wine/Windows behaviour. */
+static void dllmgr80_virtualize_screen_dc( HDC hdc, HWND hwnd )
+{
+    static int off = -1;
+    XFORM xform;
+    RECT virt, raw;
+    UINT dpi;
+
+    if (off < 0) off = getenv( "DLLMGR80_OFF" ) != NULL;
+    if (off || hwnd != get_desktop_window() || !(dpi = get_thread_dpi()))
+    {
+        set_dc_dpi_virtualization( hdc, NULL );
+        return;
+    }
+    virt = get_virtual_screen_rect( dpi, MDT_DEFAULT );
+    raw = get_virtual_screen_rect( 0, MDT_RAW_DPI );
+    if (EqualRect( &virt, &raw ) || IsRectEmpty( &virt ))
+    {
+        set_dc_dpi_virtualization( hdc, NULL );
+        return;
+    }
+    /* device units start at the desktop's own origin in both spaces */
+    xform.eM11 = (FLOAT)(raw.right - raw.left) / (virt.right - virt.left);
+    xform.eM22 = (FLOAT)(raw.bottom - raw.top) / (virt.bottom - virt.top);
+    xform.eM12 = xform.eM21 = xform.eDx = xform.eDy = 0;
+    set_dc_dpi_virtualization( hdc, &xform );
+}
+
