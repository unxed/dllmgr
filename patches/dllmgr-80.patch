 /***********************************************************************
+ *           set_dc_dpi_virtualization
+ *
+ * dllmgr #80: a DPI-unaware thread works in logical (96 DPI) screen
+ * coordinates; on a screen DC its drawing would land at the physical pixel
+ * of the same number (Windows does the same). xform maps logical to
+ * physical device units for such a DC; NULL turns it off.
+ */
+void set_dc_dpi_virtualization( HDC hdc, const XFORM *xform )
+{
+    DC *dc;
+
+    if (!(dc = get_dc_ptr( hdc ))) return;
+    if (xform || dc->dpi_virtual)
+    {
+        dc->dpi_virtual = xform != NULL;
+        if (xform) dc->dpi_xform = *xform;
+        DC_UpdateXforms( dc );
+    }
+    release_dc_ptr( dc );
+}
+
