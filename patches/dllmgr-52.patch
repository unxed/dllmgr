 static UINT font_smoothing = GGO_BITMAP;
 static UINT subpixel_orientation = GGO_GRAY4_BITMAP;
+
+/* dllmgr #52: text smoothing chosen by the user (DLLMGR52_TEXT), like the
+ * Windows font smoothing setting and unlike the per-face fontconfig flags:
+ *   system (default) - stock Wine behaviour (fontconfig flags, gasp honoured)
+ *   bitmap           - no smoothing
+ *   gray             - grayscale smoothing at every size (gasp ignored)
+ *   light            - gray with light hinting: closer to the outline shapes
+ *   cleartype        - subpixel smoothing at every size, as Windows ClearType
+ *                      (gasp "no gray" does not apply to ClearType)
+ * Explicit NONANTIALIASED_QUALITY / ANTIALIASED_QUALITY fonts keep their
+ * request. */
+int dllmgr52_text_mode(void)
+{
+    static int mode = -1;
+    if (mode == -1)
+    {
+        const char *env = getenv( "DLLMGR52_TEXT" );
+        mode = DLLMGR52_SYSTEM;
+        if (env && !strcmp( env, "bitmap" )) mode = DLLMGR52_BITMAP;
+        else if (env && !strcmp( env, "gray" )) mode = DLLMGR52_GRAY;
+        else if (env && !strcmp( env, "light" )) mode = DLLMGR52_LIGHT;
+        else if (env && !strcmp( env, "cleartype" )) mode = DLLMGR52_CLEARTYPE;
+    }
+    return mode;
+}
 static BOOL antialias_fakes = TRUE;
 static struct font_gamma_ramp font_gamma_ramp;
 
