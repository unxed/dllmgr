+        int width = scale_cursor_coord( bm.bmWidth, num, den ), height = scale_cursor_coord( bm.bmHeight, num, den );
+        HBITMAP mask, color = 0;
+
+        mask = scale_cursor_bitmap( info.hbmMask, bm.bmWidth, info.hbmColor ? bm.bmHeight : bm.bmHeight * 2,
+                                    width, info.hbmColor ? height : height * 2, TRUE );
+        if (mask && info.hbmColor)
+            color = scale_cursor_bitmap( info.hbmColor, bm.bmWidth, bm.bmHeight, width, height, FALSE );
+        if (mask && (color || !info.hbmColor))
+        {
+            NtGdiDeleteObjectApp( info.hbmMask );
+            info.hbmMask = mask;
+            if (color)
+            {
+                NtGdiDeleteObjectApp( info.hbmColor );
+                info.hbmColor = color;
+            }
+            info.xHotspot = scale_cursor_coord( info.xHotspot, num, den );
+            info.yHotspot = scale_cursor_coord( info.yHotspot, num, den );
+            bm.bmWidth = width;
+            bm.bmHeight = height;
+        }
+        else
+        {
+            if (mask) NtGdiDeleteObjectApp( mask );
+            num = den = 1; /* fall back to the unscaled cursor */
+        }
+    }
+
     hdc = NtGdiCreateCompatibleDC( 0 );
 
     if (info.hbmColor)
     {
 #ifdef SONAME_LIBXCURSOR
+        /* scaled: the icon handle is drawn stretched to the new size */
         if (pXcursorImagesLoadCursor)
             cursor = create_xcursor_cursor( hdc, &info, handle, bm.bmWidth, bm.bmHeight );
 #endif
-        if (!cursor) cursor = create_xlib_load_mono_cursor( hdc, handle, bm.bmWidth, bm.bmHeight );
+        if (!cursor && num == den) cursor = create_xlib_load_mono_cursor( hdc, handle, bm.bmWidth, bm.bmHeight );
         if (!cursor) cursor = create_xlib_color_cursor( hdc, &info, bm.bmWidth, bm.bmHeight );
         NtGdiDeleteObjectApp( info.hbmColor );
     }
@@ -1359,6 +1489,11 @@ void X11DRV_DestroyCursorIcon( HCURSOR handle )
         XFreeCursor( gdi_display, cursor );
