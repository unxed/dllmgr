+/* dllmgr #44: cursors of DPI-scaled (virtualized) windows are scaled like the
+ * window contents, as Windows does for DPI-unaware apps. Scaled X cursors are
+ * cached separately; one scale per cursor handle is assumed (the monitor DPI to
+ * window DPI ratio of the windows that use it). DLLMGR44_NO_CURSOR_SCALE=1
+ * turns it off. */
+static XContext cursor_scaled_context;
+
+static void get_cursor_scale( HWND hwnd, UINT *num, UINT *den )
+{
+    static int disabled = -1;
+    UINT window_dpi, monitor_dpi;
+
+    *num = *den = 1;
+    if (disabled < 0)
+    {
+        const char *env = getenv( "DLLMGR44_NO_CURSOR_SCALE" );
+        disabled = env && *env && *env != '0';
+    }
+    if (disabled || !hwnd) return;
+    if (!(window_dpi = NtUserGetDpiForWindow( hwnd ))) return;
+    if (!(monitor_dpi = NtUserGetWinMonitorDpi( hwnd, MDT_RAW_DPI ))) return;
+    if (monitor_dpi > window_dpi) /* never shrink */
+    {
+        *num = monitor_dpi;
+        *den = window_dpi;
+    }
+#ifdef SONAME_LIBXCURSOR
+    /* "As on Windows or better": next to the desktop's cursor theme the app's
+     * cursors keep the size relation they have on Windows, where the arrow is
+     * ~19 px tall per 96 DPI while X theme cursors fill their whole frame:
+     * scale = theme size / 19 per 96 DPI of the window, when that is larger
+     * (theme 48 at 192 DPI: 2.53 instead of 2). DLLMGR44_NO_THEME_MATCH=1
+     * keeps the plain DPI ratio. */
+    {
+        static int theme_match = -1;
+        int theme;
+        if (theme_match < 0)
+        {
+            const char *env = getenv( "DLLMGR44_NO_THEME_MATCH" );
+            theme_match = !(env && *env && *env != '0');
+        }
+        if (theme_match && pXcursorGetDefaultSize && (theme = pXcursorGetDefaultSize( gdi_display )) > 0 &&
+            (UINT64)theme * 96 * *den > (UINT64)19 * window_dpi * *num)
+        {
+            *num = theme * 96;
+            *den = 19 * window_dpi;
+        }
+    }
+#endif
+}
