+        if (!XFindContext( gdi_display, (XID)handle, context, (char **)&prev ))
         {
             /* someone else was here first */
             XFreeCursor( gdi_display, cursor );
@@ -213,8 +275,8 @@ static void set_window_cursor( Window window, HCURSOR handle )
