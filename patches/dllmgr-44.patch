+static Cursor create_cursor( HANDLE handle, UINT num, UINT den )
 {
     Cursor cursor = 0;
     ICONINFOEXW info;
@@ -1324,15 +1423,46 @@ static Cursor create_cursor( HANDLE handle )
         info.yHotspot = bm.bmHeight / 2;
