-static Cursor create_cursor( HANDLE handle )
+static int scale_cursor_coord( int value, UINT num, UINT den )
+{
+    return (int)(((LONGLONG)value * num + den / 2) / den);
+}
+
+/* dllmgr #44: stretch a cursor bitmap (nearest neighbour when enlarging) */
+static HBITMAP scale_cursor_bitmap( HBITMAP src, int width, int height, int new_width, int new_height, BOOL mono )
+{
+    HDC hdc_src = NtGdiCreateCompatibleDC( 0 ), hdc_dst = NtGdiCreateCompatibleDC( 0 );
+    HBITMAP dst = 0;
+
+    if (mono) dst = NtGdiCreateBitmap( new_width, new_height, 1, 1, NULL );
+    else
+    {
+        HDC screen = NtUserGetDC( 0 );
+        dst = NtGdiCreateCompatibleBitmap( screen, new_width, new_height );
+        NtUserReleaseDC( 0, screen );
+    }
+    if (dst)
+    {
+        NtGdiSelectBitmap( hdc_src, src );
+        NtGdiSelectBitmap( hdc_dst, dst );
+        if (!NtGdiStretchBlt( hdc_dst, 0, 0, new_width, new_height, hdc_src, 0, 0, width, height, SRCCOPY, 0 ))
+        {
+            NtGdiDeleteObjectApp( dst );
+            dst = 0;
+        }
+    }
+    NtGdiDeleteObjectApp( hdc_src );
+    NtGdiDeleteObjectApp( hdc_dst );
+    return dst;
+}
