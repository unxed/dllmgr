+/* dllmgr #66: Wine's own Tahoma Bold (tahomabd.ttf) carries embedded bitmap
+ * strikes for 9-16 px whose advance widths often differ from the font's own
+ * outline advances (and from Windows' Tahoma Bold): at 10 px "p" and "n" 7
+ * instead of 6, "B" 8 instead of 7, so text reads "Op en", "B ackground".
+ * Keep the strikes (crisp, close to Windows' shapes) but give every glyph of
+ * this face the advance of its outline rounded to whole pixels: against
+ * Windows GDI (tests/wine/text-metrics66.c) mismatching advances at 10 px go
+ * from 40 to 24 of 94, at 11 px from 24 to 13, at 16 px from 21 to 6.
+ * DLLMGR66_TAHOMA_BITMAPS=1 keeps the strike advances. */
+static BOOL dllmgr66_wine_tahoma( FT_Face ft_face )
+{
+    static int keep = -1;
+    if (keep < 0) keep = getenv( "DLLMGR66_TAHOMA_BITMAPS" ) != NULL;
+    return !keep && FT_HAS_FIXED_SIZES( ft_face ) && FT_IS_SCALABLE( ft_face ) &&
+           ft_face->family_name && !strcmp( ft_face->family_name, "Tahoma" );
+}
+
+static BOOL dllmgr66_tahoma_bold( FT_Face ft_face )
+{
+    return dllmgr66_wine_tahoma( ft_face ) && (ft_face->style_flags & FT_STYLE_FLAG_BOLD);
+}
+
+static BOOL dllmgr66_tahoma_regular( FT_Face ft_face )
+{
+    return dllmgr66_wine_tahoma( ft_face ) && !(ft_face->style_flags & (FT_STYLE_FLAG_BOLD | FT_STYLE_FLAG_ITALIC));
+}
+
+/* dllmgr #66: Windows draws simulated italic of small Tahoma by shifting the
+ * rows of the upright bitmap (black boxes against Windows GDI, 9-16 px, best
+ * fit: shift = round((height above baseline + 0.5) * 0.34); 10 px: 73 of 94
+ * glyphs identical, Wine's sheared outline: 22). Used for monochrome glyphs of
+ * Wine's regular Tahoma strikes when the slant is the only transform. */
+static int dllmgr66_shear( int top, int row )
+{
+    return (int)floor( ((top - 1 - row) + 0.5) * 0.34 + 0.5 );
+}
+
+static BOOL dllmgr66_only_slant( struct gdi_font *font, const FT_Matrix *matrices, const MAT2 *lpmat )
+{
+    static const MAT2 identity = { {0,1},{0,0},{0,0},{0,1} };
+    int i;
+    if (!matrices || !font->fake_italic || font->fake_bold || getenv( "DLLMGR66_OUTLINE_ITALIC" )) return FALSE;
+    if (lpmat && memcmp( lpmat, &identity, sizeof(identity) )) return FALSE;
+    for (i = 0; i < 3; i++)
+        if (matrices[i].xx != (1 << 16) || matrices[i].xy != (1 << 16) >> 2 ||
+            matrices[i].yx != 0 || matrices[i].yy != (1 << 16)) return FALSE;
+    return TRUE;
+}
+
+/* the sheared copy of a mono strike glyph, rows top-down, DWORD-aligned */
+static DWORD dllmgr66_sheared_bitmap( FT_GlyphSlot glyph, int min_shift, DWORD width, DWORD height,
+                                      DWORD buflen, BYTE *buf )
+{
+    DWORD pitch = ((width + 31) >> 5) << 2, needed = pitch * height;
+    unsigned int r, x;
+
+    if (!buf || !buflen) return needed;
+    if (!needed) return GDI_ERROR;
+    if (needed > buflen) return GDI_ERROR;
+    memset( buf, 0, needed );
+    for (r = 0; r < glyph->bitmap.rows && r < height; r++)
+    {
+        const BYTE *src = glyph->bitmap.buffer + r * glyph->bitmap.pitch;
+        int shift = dllmgr66_shear( glyph->bitmap_top, r ) - min_shift;
+        for (x = 0; x < glyph->bitmap.width; x++)
+            if (src[x >> 3] & (0x80 >> (x & 7)) && x + shift < width)
+                buf[r * pitch + ((x + shift) >> 3)] |= 0x80 >> ((x + shift) & 7);
+    }
+    return needed;
+}
