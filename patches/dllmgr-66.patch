+/* dllmgr #66: Tahoma served by another family inside one application (the
+ * runtime gets the `dllmgr set <app> tahoma=` setting as environment):
+ * DLLMGR66_TAHOMA=<family> takes every Tahoma request, DLLMGR66_TAHOMA_BOLD
+ * only the bold ones. The application still sees the name "Tahoma". Unlike
+ * [Fonts\Replacements] this works while Wine's own Tahoma is installed. */
+static const WCHAR *dllmgr66_tahoma_subst( const LOGFONTW *lf )
+{
+    static const WCHAR tahomaW[] = {'T','a','h','o','m','a',0};
+    static WCHAR all[LF_FACESIZE], bold[LF_FACESIZE];
+    static int init;
+
+    if (!init)
+    {
+        const char *env[2] = {getenv( "DLLMGR66_TAHOMA" ), getenv( "DLLMGR66_TAHOMA_BOLD" )};
+        WCHAR *dst[2] = {all, bold};
+        int i, j;
+        for (i = 0; i < 2; i++)
+            for (j = 0; env[i] && env[i][j] && j < LF_FACESIZE - 1; j++) dst[i][j] = (unsigned char)env[i][j];
+        init = 1;
+    }
+    if (!all[0] && !bold[0]) return NULL;
+    if (wcsicmp( lf->lfFaceName, tahomaW )) return NULL;
+    if (bold[0] && lf->lfWeight > FW_MEDIUM) return bold;
+    return all[0] ? all : NULL;
+}
