+/* dllmgr #52b: on a GDI-scaled DC the application must see the 96-DPI metrics,
+ * so advances come from the unscaled font, times the hidden scale (device units). */
+static DWORD metrics_outline( struct font_physdev *physdev, UINT glyph, UINT format, ABC *abc )
+{
+    DWORD ret;
+
+    if (!physdev->mfont) return get_glyph_outline( physdev->font, glyph, format, NULL, abc, 0, NULL, NULL );
+    ret = get_glyph_outline( physdev->mfont, glyph, format, NULL, abc, 0, NULL, NULL );
+    abc->abcA *= (int)physdev->mk;
+    abc->abcB *= physdev->mk;
+    abc->abcC *= (int)physdev->mk;
+    return ret;
+}
