+    otm->otmTextMetrics.tmAscent *= k;
+    otm->otmTextMetrics.tmDescent *= k;
+    otm->otmTextMetrics.tmInternalLeading *= k;
+    otm->otmTextMetrics.tmExternalLeading *= k;
+    otm->otmTextMetrics.tmAveCharWidth *= k;
+    otm->otmTextMetrics.tmMaxCharWidth *= k;
+    otm->otmTextMetrics.tmOverhang *= k;
+    otm->otmAscent *= k;
+    otm->otmDescent *= k;
+    otm->otmLineGap *= k;
+    otm->otmsCapEmHeight *= k;
+    otm->otmsXHeight *= k;
+    otm->otmrcFontBox.top *= k;
+    otm->otmrcFontBox.bottom *= k;
+    otm->otmrcFontBox.left *= k;
+    otm->otmrcFontBox.right *= k;
+    otm->otmMacAscent *= k;
+    otm->otmMacDescent *= k;
+    otm->otmMacLineGap *= k;
+    otm->otmptSubscriptSize.x *= k;
+    otm->otmptSubscriptSize.y *= k;
+    otm->otmptSubscriptOffset.x *= k;
+    otm->otmptSubscriptOffset.y *= k;
+    otm->otmptSuperscriptSize.x *= k;
+    otm->otmptSuperscriptSize.y *= k;
+    otm->otmptSuperscriptOffset.x *= k;
+    otm->otmptSuperscriptOffset.y *= k;
+    otm->otmsStrikeoutSize *= k;
+    otm->otmsStrikeoutPosition *= k;
+    otm->otmsUnderscoreSize *= k;
+    otm->otmsUnderscorePosition *= k;
+}
