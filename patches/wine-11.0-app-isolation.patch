+/* Private dllmgr runtime: opt in by the complete Windows image path.
+ * Do not redirect explicit paths, or propagate a basename rule to children. */
+static NTSTATUS find_dllmgr_dll( const WCHAR *libname, WCHAR **fullname )
+{
+    const WCHAR *variable;
+    UNICODE_STRING target, path;
+    WCHAR *canonical;
+    ULONG size;
+
+    if (!wcsicmp( libname, L"gdiplus.dll" )) variable = L"DLLMGR_GDIPLUS";
+    else if (!wcsicmp( libname, L"comctl32.dll" )) variable = L"DLLMGR_COMCTL32";
+    else return STATUS_SXS_KEY_NOT_FOUND;
+
+    if (get_env_var( L"DLLMGR_TARGET_EXE", 0, &target )) return STATUS_SXS_KEY_NOT_FOUND;
+    if (!RtlEqualUnicodeString( &target, &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName, TRUE ))
+    {
+        RtlFreeUnicodeString( &target );
+        return STATUS_SXS_KEY_NOT_FOUND;
+    }
+    RtlFreeUnicodeString( &target );
+    if (get_env_var( variable, 0, &path )) return STATUS_DLL_NOT_FOUND;
+    if (RtlDetermineDosPathNameType_U( path.Buffer ) != RtlPathTypeDriveAbsolute)
+    {
+        RtlFreeUnicodeString( &path );
+        return STATUS_DLL_NOT_FOUND;
+    }
+    /* The Unix load-order rule compares the final NT path. Refuse aliases
+     * that would normalize differently and bypass the native-only rule. */
+    size = RtlGetFullPathName_U( path.Buffer, 0, NULL, NULL );
+    canonical = RtlAllocateHeap( GetProcessHeap(), 0, size );
+    if (!canonical || !RtlGetFullPathName_U( path.Buffer, size, canonical, NULL ) ||
+        wcsicmp( path.Buffer, canonical ))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, canonical );
+        RtlFreeUnicodeString( &path );
+        return STATUS_DLL_NOT_FOUND;
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, canonical );
+    TRACE( "dllmgr redirects %s to %s\n", debugstr_w(libname), debugstr_w(path.Buffer) );
+    *fullname = path.Buffer;
+    return STATUS_SUCCESS;
+}
