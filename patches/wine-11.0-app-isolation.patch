+/* Use Wine's Unix-to-UTF16 conversion, as used for the process environment. */
+static WCHAR *dllmgr_get_path( const char *name )
+{
+    const char *value = getenv( name );
+    WCHAR *path;
+    size_t len;
+
+    if (!value) return NULL;
+    len = strlen(value) + 1;
+    if (!(path = malloc( len * sizeof(WCHAR) ))) return NULL;
+    ntdll_umbstowcs( value, len, path, len );
+    path[len - 1] = 0;
+    /* Only canonical drive-absolute Windows paths are accepted. */
+    if (!path[0] || path[1] != ':' || path[2] != '\\')
+    {
+        free( path );
+        return NULL;
+    }
+    return path;
+}
+
+static BOOL dllmgr_native_path( const UNICODE_STRING *name )
+{
+    static const WCHAR prefix[] = {'\\','?','?','\\'};
+    static const char *variables[] = { "DLLMGR_GDIPLUS", "DLLMGR_COMCTL32" };
+    const WCHAR *buffer = name->Buffer;
+    unsigned int len = name->Length / sizeof(WCHAR), i;
+    WCHAR *path;
+    BOOL match;
+
+    if (!dllmgr_app_name || !(path = dllmgr_get_path( "DLLMGR_TARGET_EXE" ))) return FALSE;
+    match = !wcsicmp( path, dllmgr_app_name );
+    free( path );
+    if (!match) return FALSE;
+    if (len > 4 && !wcsncmp( buffer, prefix, ARRAY_SIZE(prefix) )) { buffer += 4; len -= 4; }
+    for (i = 0; i < ARRAY_SIZE(variables); i++)
+    {
+        if (!(path = dllmgr_get_path( variables[i] ))) continue;
+        match = wcslen(path) == len && !wcsnicmp( path, buffer, len );
+        free( path );
+        if (match) return TRUE;
+    }
+    return FALSE;
+}
