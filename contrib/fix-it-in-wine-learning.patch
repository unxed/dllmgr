+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+TOOL = Path(__file__).resolve().parents[1]/"tools/record_attempt.py"
+
+
+class RecordTest(unittest.TestCase):
+    def run_attempt(self, code, *options):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        root = Path(temporary.name)
+        result = subprocess.run([sys.executable,str(TOOL),"--root",str(root),"--case","case-1",
+                                 "--stage","reproduce","--hypothesis","test","--expected","test",
+                                 *options,"--",sys.executable,"-c",code],capture_output=True,timeout=10)
+        metadata = next(root.glob("case-1/*/attempt.json"))
+        return result, json.loads(metadata.read_text()), metadata.parent
+
+    def test_non_utf8_failure_is_preserved(self):
+        result, record, directory = self.run_attempt("import os; os.write(2,b'\\xad\\xa5'); raise SystemExit(7)")
+        self.assertEqual(result.returncode,7)
+        self.assertEqual(record["status"],"unexpected_exit")
+        self.assertEqual((directory/"stderr.bin").read_bytes(),b"\xad\xa5")
+        self.assertEqual(directory.stat().st_mode & 0o777,0o700)
+        self.assertEqual((directory/"attempt.json").stat().st_mode & 0o777,0o600)
+
+    def test_expected_baseline_exit_is_not_an_unexpected_failure(self):
+        result, record, _ = self.run_attempt("raise SystemExit(1)","--expected-exit","1")
+        self.assertEqual(result.returncode,1)
+        self.assertEqual(record["status"],"expected_exit")
+
+    def test_timeout_still_records_output_and_duration(self):
+        result, record, directory = self.run_attempt("import os,time; os.write(1,b'started'); time.sleep(30)","--timeout","0.2")
+        self.assertEqual(result.returncode,124)
+        self.assertEqual(record["status"],"timeout")
+        self.assertEqual((directory/"stdout.bin").read_bytes(),b"started")
+        self.assertGreaterEqual(record["elapsed_seconds"],0.2)
