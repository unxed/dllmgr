+#!/usr/bin/env python3
+"""Run an experiment and retain failure evidence in a private case directory."""
+import argparse
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import signal
+import subprocess
+import sys
+import time
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--case", required=True)
+    parser.add_argument("--stage", required=True)
+    parser.add_argument("--hypothesis", required=True)
+    parser.add_argument("--expected", required=True)
+    parser.add_argument("--expected-exit", type=int, default=0)
+    parser.add_argument("--context-file", type=Path)
+    parser.add_argument("--timeout", type=float)
+    parser.add_argument("--root", type=Path, default=Path.home()/".local/share/fix-it-in-wine/cases")
+    parser.add_argument("command", nargs=argparse.REMAINDER)
+    args = parser.parse_args(argv)
+    command = args.command[1:] if args.command[:1] == ["--"] else args.command
+    if not command or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", args.case):
+        parser.error("a safe case ID and a command after -- are required")
+    context = json.loads(args.context_file.read_text()) if args.context_file else {}
+    started = datetime.now(timezone.utc)
+    directory = args.root/args.case/(started.strftime("%Y%m%dT%H%M%S")+"-%d" % time.time_ns())
+    directory.mkdir(parents=True, mode=0o700)
+    directory.parent.chmod(0o700)
+    record = dict(case=args.case, stage=args.stage, hypothesis=args.hypothesis,
+                  expected=args.expected, expected_exit=args.expected_exit,
+                  command=command, cwd=os.getcwd(), started_at=started.isoformat(),
+                  context=context, locale={k: os.environ.get(k) for k in ("LC_ALL","LC_CTYPE","LANG","LANGUAGE")})
+    begin = time.monotonic()
+    status, rc = "launch_error", 127
+    with open(directory/"stdout.bin", "wb") as out, open(directory/"stderr.bin", "wb") as err:
+        try:
+            process = subprocess.Popen(command, stdout=out, stderr=err, start_new_session=True)
+            try:
+                rc = process.wait(timeout=args.timeout)
+                status = "expected_exit" if rc == args.expected_exit else "unexpected_exit"
+            except (subprocess.TimeoutExpired, KeyboardInterrupt) as error:
+                status = "timeout" if isinstance(error, subprocess.TimeoutExpired) else "interrupted"
+                os.killpg(process.pid, signal.SIGTERM)
+                try:
+                    process.wait(timeout=2)
+                except subprocess.TimeoutExpired:
+                    os.killpg(process.pid, signal.SIGKILL)
+                    process.wait()
+                rc = 124 if status == "timeout" else 130
+        except OSError as error:
+            record["error"] = str(error)
+    record.update(status=status, returncode=rc, elapsed_seconds=time.monotonic()-begin,
+                  finished_at=datetime.now(timezone.utc).isoformat())
+    for channel in ("stdout", "stderr"):
+        path = directory/(channel+".bin")
+        path.chmod(0o600)
+        data = path.read_bytes()
+        record[channel] = dict(file=path.name, bytes=len(data), sha256=hashlib.sha256(data).hexdigest())
+        if status != "expected_exit" and data:
+            print(channel+" tail: "+data[-4096:].decode("utf-8", errors="backslashreplace"), file=sys.stderr)
+    metadata = directory/"attempt.json"
+    metadata.write_text(json.dumps(record, ensure_ascii=False, indent=2)+"\n")
+    metadata.chmod(0o600)
+    print("attempt: %s\nstatus: %s, exit: %d, elapsed: %.3fs" % (metadata,status,rc,record["elapsed_seconds"]))
+    return rc if rc >= 0 else 128-rc
+
+
+if __name__ == "__main__":
+    sys.exit(main())
